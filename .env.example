# ---------------------------------------------------------------------------
# DemoSage CS2 Agentic Coach — Local Environment Template
# Copy to .env and fill in. Placeholders only — never commit real values.
# ---------------------------------------------------------------------------

# Local mode: skip GCS/Cloud Tasks, use local stubs (see CLAUDE.md)
LOCAL_MODE=true
APP_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/demosage
# REDIS_URL=redis://localhost:6379          # only for FACEIT OAuth state

# AI
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# API auth (frontend server routes -> backend)
API_SHARED_SECRET=pick_any_local_secret

# Qdrant Cloud (RAG vector store)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Google Cloud (unused when LOCAL_MODE=true)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-demos-bucket
GCP_SERVICE_ACCOUNT=your-sa@your-gcp-project-id.iam.gserviceaccount.com
# Go demo-parser service (local: go run ./services/demo-parser)
PARSER_SERVICE_URL=http://localhost:8080

# Pipeline worker knobs (defaults are fine locally)
# WORKER_POLL_INTERVAL=2
# COACH_CONCURRENCY=4
# SCRIBE_LLM_CONCURRENCY=8

# Pro-meta RAG ingestion (fixture client used when unset or LOCAL_MODE)
# HLTV_API_BASE=

# DatHost practice servers (uncomment the mock to bypass the paywall locally)
# DATHOST_API_URL=http://localhost:8001
# DATHOST_EMAIL=
# DATHOST_PASSWORD=

# FACEIT OAuth
FACEIT_CLIENT_ID=your-faceit-app-client-id
FACEIT_CLIENT_SECRET=your-faceit-app-client-secret
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Discord stratbook sync
DISCORD_PUBLIC_KEY=your-discord-app-public-key-hex
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_WEBHOOK_SECRET=pick_any_local_secret_for_bind_codes
MINIMAP_BASE_URL=https://your-cdn.example.com/minimaps
