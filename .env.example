# ---------------------------------------------------------------------------
# DemoSage CS2 Agentic Coach — Local Environment Template
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/demosage
REDIS_URL=redis://localhost:6379

# AI Config
GEMINI_API_KEY=your_gemini_api_key_here

# Steam Web API (for vanity URL resolution on profile page)
STEAM_API_KEY=your_steam_web_api_key_here

# DatHost / Server Configuration
# Uncomment the line below to use the local mock API and bypass the DatHost paywall
# DATHOST_API_URL=http://localhost:8001

# Steam + FACEIT OAuth
FACEIT_CLIENT_ID=your-faceit-app-client-id
FACEIT_CLIENT_SECRET=your-faceit-app-client-secret
API_BASE_URL=https://api.demosage.gg
FRONTEND_URL=https://demosage.gg

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
